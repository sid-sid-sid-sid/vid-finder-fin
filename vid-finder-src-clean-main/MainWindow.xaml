<Window x:Class="filmfinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FilmFinder"
        Height="200" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#1a1a2e">

    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1a1a2e" CornerRadius="10" MouseLeftButtonDown="Border_MouseDown">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <TextBlock Text="🎬 VidFinder"
                           Foreground="White"
                           FontFamily="Segoe UI Semibold"
                           FontSize="18"
                           VerticalAlignment="Center"/>
                <Button x:Name="CloseButton"
                        Content="✕"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Width="28" Height="28"
                        Background="#444466"
                        Padding="0"
                        Style="{StaticResource FlatButton}"
                        Click="CloseButton_Click"/>
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#16213e"
                        CornerRadius="6"
                        BorderBrush="#444466"
                        BorderThickness="1">
                    <TextBlock x:Name="FilePathText"
                               Text="No file selected…"
                               Foreground="#888aaa"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Padding="10,0,10,0"
                               VerticalAlignment="Center"
                               Height="36"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <Button x:Name="UploadButton"
                        Grid.Column="2"
                        Content="Browse"
                        Width="80" Height="36"
                        Background="#533483"
                        Padding="0"
                        Style="{StaticResource FlatButton}"
                        Click="Upload_Click"/>
            </Grid>

            <TextBlock x:Name="StatusText"
                       Grid.Row="4"
                       Text=""
                       Foreground="White"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       TextWrapping="Wrap"
                       MinHeight="18"/>

            <ProgressBar x:Name="ProgressBar"
                         Grid.Row="4"
                         Height="4"
                         VerticalAlignment="Bottom"
                         Background="#16213e"
                         Foreground="#e94560"
                         BorderThickness="0"
                         IsIndeterminate="True"
                         Visibility="Collapsed"/>

            <Button x:Name="RunButton"
                    Grid.Row="4"
                    Content="▶  Run"
                    Background="#e94560"
                    Padding="0"
                    IsEnabled="False"
                    Style="{StaticResource FlatButton}"
                    Click="Run_Click" Grid.RowSpan="3" Margin="0,0,0,-31"/>
        </Grid>
    </Border>
</Window>